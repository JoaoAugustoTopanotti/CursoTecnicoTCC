# Copie este arquivo para .env.local e preencha com os seus valores reais.
# O arquivo .env.local é ignorado pelo Git (padrão `.env*` no .gitignore)
# e por isso NUNCA deve ser versionado.

# --- Firebase (configuração pública do cliente, prefixo NEXT_PUBLIC_) ---
NEXT_PUBLIC_FIREBASE_API_KEY=sua_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu_projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# --- Firebase Admin SDK (servidor) ---
# Gere uma nova chave no Console do Firebase > Configurações > Contas de serviço.
FIREBASE_PROJECT_ID=seu_projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seu_projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- E-mail (Cloud Function de notificação de agendamento) ---
# Use uma "Senha de app" do Gmail, nunca a senha real da conta.
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app
GERENTE_EMAIL=email_do_gerente@gmail.com

# --- Stripe (pagamentos) ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
